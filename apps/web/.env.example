# Leave empty to call the API on the same origin (the dev server proxies /api, /uploads and /socket.io).
VITE_API_URL=
# Where the dev server proxies API calls.
VITE_DEV_API_TARGET=http://localhost:4000
# Map tiles. The public OSM servers are for light use only — use a tile provider (MapTiler, Stadia, Carto…) in production.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
