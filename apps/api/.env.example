# Local development settings for the API (copy to apps/api/.env). Every value has a dev default.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://urbanfix:urbanfix@localhost:5432/urbanfix
REDIS_URL=redis://localhost:6379
WEB_ORIGIN=http://localhost:5173
PUBLIC_API_URL=http://localhost:4000

# queue = BullMQ (run `pnpm dev:worker` too); inline = run background jobs inside the API process
JOBS_MODE=inline

# Google AI Studio key for photo analysis and image embeddings (optional).
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# Optional
GEOCODER_EMAIL=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CITY_NAME=Pune
CITY_LAT=18.5204
CITY_LNG=73.8567
LOG_LEVEL=info
