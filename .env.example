# ---- docker compose settings (copy to .env) ----

# Required: random string, 32+ characters (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=
POSTGRES_PASSWORD=urbanfix

# Public origin of the app (what users type in the browser).
PUBLIC_URL=http://localhost:8080
WEB_PORT=8080
# Set to true when serving over HTTPS (required for production).
COOKIE_SECURE=false

# AI: Google AI Studio key. Leave empty to run with heuristics only.
GEMINI_API_KEY=
GEMINI_MODELS=gemini-flash-latest,gemini-flash-lite-latest

# City shown on maps and used for the demo seed.
CITY_NAME=Pune
CITY_LAT=18.5204
CITY_LNG=73.8567

# Reverse geocoding (Nominatim-compatible). Set a contact email per the Nominatim usage policy.
GEOCODER_URL=https://nominatim.openstreetmap.org
GEOCODER_EMAIL=

# Map tiles baked into the web build. Use a commercial/self-hosted provider in production.
VITE_MAP_TILE_URL=
VITE_MAP_ATTRIBUTION=
VITE_SHOW_DEMO_ACCOUNTS=false

# Web Push (optional): generate with `npx web-push generate-vapid-keys`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.org

# Storage: local (volume) or s3 (AWS S3, Cloudflare R2, MinIO).
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
